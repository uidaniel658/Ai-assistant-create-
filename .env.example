PORT=3000
# Bind all interfaces so containers and hosted preview proxies can reach ALTREX.
HOST=0.0.0.0
ALTREX_DATA_DIR=.altrex
# Optional: configure an OpenAI-compatible endpoint server-side.
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
SESSION_SECRET=replace-this-with-a-long-random-value
